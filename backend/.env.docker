DB_URI=mongodb://mongo:27017/japanese
# REDIS_URL=redis://redis:6379
JWT_SECRET=secret
JWT_EXPIRES_IN=1d
SMTP_USER=
SMTP_PASS=
ARCJET_KEY=
ARCJET_ENV=production
ADMIN_ID=
